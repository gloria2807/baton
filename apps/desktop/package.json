{
  "name": "@baton/desktop",
  "productName": "Baton",
  "private": true,
  "version": "0.1.0",
  "description": "Baton: point, speak, and conduct agents in your own browser.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "selftest": "node build.mjs && electron . --selftest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "dist": "node build.mjs && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@baton/core": "*",
    "@baton/model": "*",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  },
  "author": "Gloria Enyi",
  "build": {
    "appId": "app.baton.desktop",
    "productName": "Baton",
    "copyright": "Built during the Meta Global AI Developer Hackathon",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "electronDist": "../../node_modules/electron/dist",
    "electronVersion": "45.1.0",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Baton-Setup-${version}.${ext}",
      "shortcutName": "Baton"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false
  }
}
